# Single source of brand/build values for the shell scripts.
# Keep in sync with Sources/GuardCore/Brand.swift. Renaming the product = edit these two files.
APP_NAME="Warden"
BUNDLE_ID="com.dakcyber.warden"
HOOK_NAME="warden-hook"          # CLI file name inside the bundle and in agent hook configs
APP_VERSION="0.1.0"
APP_BUILD="1"
MIN_MACOS="14.0"
EXECUTABLE_TARGET="App"          # SwiftPM product names (generic on purpose)
HOOK_TARGET="Hook"
ENV_PREFIX="WARDEN_"            # prefix of env overrides (Brand.envPrefix)
